\section{}
    \subsection{}
        \begin{align*}
             p(\sigma^{-2}|\mu=0,y_1,\dots,y_n)&\propto p(y_1,\dots,y_n|\mu=0,\sigma^2)p(\mu=0)p(\sigma^{-2})\\
            &=p(y_1,\dots,y_n|\mu=0,\sigma^2)p(\sigma^{-2})\\
            &\propto \prod^n_{i=1}\frac{1}{\sigma}\exp\left(-\frac 12 \sigma^{-2}y_i^2\right)\cdot(\sigma^{-2})^{a-1}\exp(-b\sigma^{-2})\\
            &\propto \sigma^{n+a-1} \exp\left(-\sigma^{-2}\left(\frac 12 \sum_{i=1}^ny_i^2 + b\right)\right)\\
            \implies \sigma^{-2}|\mu=0,y_1,\dots,y_n&\sim GAM\left(n+a, \frac 12 \sum_{i=1}^ny_i^2 + b\right)
        \end{align*}
        
        I inititially attempted to compute the distribution without given $b$ though I couldn't tell if it was proportional to any known distribution, so left it as a proportion below.
        \begin{align*}
                p(\sigma^{-2}|\mu=0,y_1,\dots,y_n)&\propto p(y_1,\dots,y_n|\mu=0,\sigma^2)p(\mu=0)p(\sigma^{-2})\\
                &=p(y_1,\dots,y_n|\mu=0,\sigma^2)p(\sigma^{-2})\\
                &=p(y_1,\dots,y_n|\mu=0,\sigma^2)\int_0^\infty p(\sigma^{-2}|b)p(b)db\\
                &= p(y_1,\dots,y_n|\mu=0,\sigma^2)\int_0^\infty \frac{b^a}{\Gamma(a)}(\sigma^{-2})^{a-1}e^{-\sigma^{-2}b}\frac{\beta^\alpha}{\Gamma(\alpha)}b^{\alpha-1}e^{-b\beta}db\\
                &= p(y_1,\dots,y_n|\mu=0,\sigma^2)\int_0^\infty \frac{b^a}{\Gamma(a)}(\sigma^{-2})^{a-1}e^{-\sigma^{-2}b}\frac{\beta^\alpha}{\Gamma(\alpha)}b^{\alpha-1}e^{-b\beta}db\\
                &= p(y_1,\dots,y_n|\mu=0,\sigma^2)
                \frac{ (\sigma^{-2})^{a-1}}{\Gamma(a)\Gamma(\alpha)}\frac{\Gamma(a+\alpha)}{(\beta+\sigma^{-2})^{a+\alpha}}\int_0^\infty\frac{(\beta+\sigma^{-2})^{a+\alpha}}{\Gamma(a+\alpha)} b^{a+\alpha-1}\exp(-b(\beta+\sigma^{-2}))db\\
                &= \prod_{i=1}^n\frac{1}{\sqrt{2\pi}\sigma}\exp\left(-\frac12\sigma^{-2}y_i^2\right) (\sigma^{-2})^{a-1}
                \frac{1}{\Gamma(a)\Gamma(\alpha)}\frac{\Gamma(a+\alpha)}{(\beta+\sigma^{-2})^{a+\alpha}}\\
                &= \frac{1}{(\sqrt{2\pi})^n}\exp\left(-\frac12\sigma^{-2}\sum_{i=1}^n(y_i)^2\right) (\sigma^{-2})^{\frac n2+a-1}
                \frac{1}{\Gamma(a)\Gamma(\alpha)}\frac{\Gamma(a+\alpha)}{(\beta+\sigma^{-2})^{a+\alpha}}\\
                &\propto  \exp\left(-\frac12\sigma^{-2}\sum_{i=1}^n(y_i)^2\right) (\sigma^{-2})^{\frac n2+a-1}\frac{1}{(\beta+\sigma^{-2})^{a+\alpha}}\\
        \end{align*}
    \subsection{}
        \begin{align*}
            p(b|a,\sigma^{-2})&\propto p(\sigma^{-2}|a,b)\cdot p(a,b)\\
            &=p(\sigma^{-2}|a,b)\cdot p(b)\\
            &= b^{\alpha-1}\exp\left(-b\beta\right)(\sigma^{-2})^{a-1}\exp\left(-\sigma^{-2}b\right)\frac{b^a}{\Gamma(a)}\frac{\beta^\alpha}{\Gamma(\alpha)}\\
            &\propto b^{\alpha-1}\exp\left(-b\beta\right)\exp\left(-\sigma^{-2}b\right)b^a\\
            &= b^{\alpha+a-1}\exp\left(-b(\beta+\sigma^{-2})\right)\\
            \implies b|a,\sigma^{-2} &\sim GAM\left(\alpha + a, \beta + \sigma^{-2}\right)
        \end{align*}
\section{}
    \subsection{}
        \begin{align*}
            P(\theta_1,\dots,\theta_K|y_1,\dots,y_n)&=P(\theta_1,\dots,\theta_K)\cdot P(y_1,\dots,y_n|\theta_1,\dots,\theta_K)\\
            &\propto\prod_{k=1}^K\left(\theta_k^{\alpha_k-
            1}\right)\prod_{j=1}^n\prod_{k=1}^K\left(\theta_k^{I(y_j=k)}\right)\\
            &=\prod_{k=1}^K\left(\theta_k^{\alpha_k-1}\right)\prod_{k=1}^K\left(\theta_k^{\sum_{j=1}^nI(y_j=k)}\right)\\
            &=\prod_{k=1}^K\left(\theta_k^{\alpha_k-1}\theta_k^{\sum_{j=1}^nI(y_j=k)}\right)\\
            &=\prod_{k=1}^K\left(\theta_k^{n_k+\alpha_k-1}\right)\\
            \implies \theta_1,\dots,\theta_K|Y_1,\dots,Y_n&\sim DIR\left({\alpha_1+n_1},\dots, {\alpha_K+n_K}\right)
        \end{align*}
    \subsection{}
        We note that $p(\theta_1,\dots,\theta_K)=\frac{\Gamma\left(\sum^K_{k=1}\alpha_k+n_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k+n_k)}\prod_{k=1}^K\left(\theta_k^{n_k+\alpha_k-1}\right)$ is the density function of a Dirichlet distribution so we have $\idotsint_\Theta\frac{\Gamma\left(\sum^K_{k=1}\alpha_k+n_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k+n_k)}\prod_{k=1}^K\left(\theta_k^{n_k+\alpha_k-1}\right)d\theta_1\dots d\theta_K=1$, which we use getting to the final line.
        \begin{align*}
            p(y_1,\dots,y_n)&=\idotsint_\Theta p(y_1,\dots,y_n|(\theta_1,\dots,\theta_K))p(\theta_1,\dots,\theta_K)d\theta_1\dots d\theta_K\\
            &=\idotsint_\Theta\frac{\Gamma\left(\sum^K_{k=1}\alpha_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k)}\prod_{k=1}^K\left(\theta_k^{n_k+\alpha_k-1}\right)d\theta_1\dots d\theta_K\\
            &=\frac{\Gamma\left(\sum^K_{k=1}\alpha_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k)}\cdot\left(\frac{\Gamma\left(\sum^K_{k=1}\alpha_k+n_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k+n_k)}\right)^{-1}\cdot\idotsint_\Theta\frac{\Gamma\left(\sum^K_{k=1}\alpha_k+n_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k+n_k)}\prod_{k=1}^K\left(\theta_k^{n_k+\alpha_k-1}\right)d\theta_1\dots d\theta_K\\
            &=\frac{\Gamma\left(\sum^K_{k=1}\alpha_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k)}\cdot\left(\frac{\Gamma\left(\sum^K_{k=1}\alpha_k+n_k\right)}{\prod^K_{k=1}\Gamma(\alpha_k+n_k)}\right)^{-1}
        \end{align*}

    \subsection{}
        We have that $Y_{n+1}\sim CAT(\lambda_1,\dots,\lambda_K)$ where $(\Lambda_1,\dots,\Lambda_K)\sim DIR(\alpha_1+n_1,\dots,\alpha_K+n_K)$ by (a). I'm not able to follow the notation like at all if I use $\theta$ here again hence a different variable. We additionally apply (b) to compute.
        \begin{align*}
            p(y_{n+1}=k|y_1,\dots,y_{n})&=\idotsint_\Theta p(y_{n+1}|(\lambda_1,\dots,\lambda_K))p((\lambda_1,\dots,\lambda_K))d\lambda_1\dots d\lambda_K\\
            &=\left(\frac{\Gamma\left(\sum^K_{j=1}\alpha_j+n_j\right)}{\prod^K_{j=1}\Gamma(\alpha_j+n_j)}\cdot\left(\frac{\Gamma\left(1+\sum_{j=1}^K\alpha_j+n_j\right)}{\Gamma(a_k+n_k+1)\prod_{j\ne k}\Gamma(\alpha_j+n_j)}\right)^{-1}\right)\\
            &=  \left(\frac{\Gamma\left(\sum^K_{j=1}\alpha_j+n_j\right)}{\Gamma\left(1+\sum_{j=1}^K\alpha_j+n_j\right)} \cdot   \left(\frac{\prod^K_{j=1}\Gamma(\alpha_j+n_j)}{\Gamma(a_k+n_k+1)\prod_{j\ne k}\Gamma(\alpha_j+n_j)}\right)^{-1}\right)\\
            &= \left(\frac{\Gamma\left(\sum^K_{j=1}\alpha_j+n_j\right)}{\Gamma\left(\sum_{j=1}^K\alpha_j+n_j\right)\cdot\left(\sum_{j=1}^K\alpha_j+n_j\right)} \cdot   \left(\frac{\prod^K_{j=1}\Gamma(\alpha_j+n_j)}{\Gamma(a_k+n_k+1)\prod_{j\ne k}\Gamma(\alpha_j+n_j)}\right)^{-1}\right)\\
            &= \left(\frac{1}{\left(\sum_{j=1}^K\alpha_j+n_j\right)} \cdot   \left(\frac{\prod^K_{j=1}\Gamma(\alpha_j+n_j)}{(a_k+n_k)\prod^K_{j=1}\Gamma(\alpha_j+n_j)}\right)^{-1}\right)\\
            &=\frac{a_k+n_k}{\alpha+n}\\
        \end{align*}
