## Data
# SCHOOL s=1
Y1 <- c(
  2.11, 9.75, 13.88, 11.3, 8.93, 15.66, 16.38, 4.54, 8.86, 11.94, 12.47, 11.11,
  11.65, 14.53, 9.61, 7.38, 3.34, 9.06, 9.45, 5.98, 7.44, 8.5, 1.55, 11.45, 9.73
)

# SCHOOL s=2
Y2 <- c(
  0.29, 1.13, 6.52, 11.72, 6.54, 5.63, 14.59, 11.74, 9.12, 9.43, 10.64, 12.28,
  9.5, 0.63, 15.35, 5.31, 8.49, 3.04, 3.77, 6.22, 2.14, 6.58, 1.11
)

# SCHOOL s=3
Y3 <- c(
  4.33, 7.77, 4.15, 5.64, 7.69, 5.04, 10.01, 13.43, 13.63, 9.9, 5.72, 5.16, 4.33
  , 12.9, 11.27, 6.05, 0.95, 6.02, 12.22, 12.85
)

## Initialization
Y <- list(Y1, Y2, Y3)
Ynames <- list("Y1", "Y2", "Y3")

# Inputs:
# mu0 - first parameter mu of prior on mu prior
# tau0 - second parameter sigma^2 on mu prior
# a - first parameter a on sigma^{-2} prior
# b - second parameter b on sigma^{-2} prior
# Yi - samples
# Outputs
# gibbsIter - Function taking previous samples mu_t and sigma^2_t and returning
# next samples mu_{t+1} and sigma_{t+1}
iterFunc <- function(mu0, tau0, a, b, Yi) {
  gibbsIter <- function(mui, sigmai) {
    n <- length(Yi)
    muVar <- 1 / (n / sigmai + 1 / tau0)
    muMean <- muVar * (sum(Yi) / sigmai + mu0 / tau0)
    muNew <- rnorm(1, mean = muMean, sd = sqrt(muVar))
    aTilde <- a + n / 2
    bTilde <- b + 1 / 2 * sum((Yi - rep(muNew, n))^2)
    sigmaNew <- 1 / rgamma(1, shape = aTilde, rate = bTilde)
    c(muNew, sigmaNew)
  }
  gibbsIter
}
# Inputs:
# Yi - samples
# length - Number of samples to generate
# Outputs
# (mus, sigmas) - Vector with first length many items being the mu samples and
# remaining length many items the sigma samples
Gibbs <- function(Yi, length) {
  mu0 <- rnorm(1, mean = 5, sd = sqrt(4))
  sigma0 <- 1 / rgamma(1, shape = 1, rate = 4)
  iterYi <- iterFunc(5, sqrt(4), 1, 4, Yi)
  mus <- rep(1, length)
  sigmas <- rep(1, length)
  mus[1] <- mu0
  sigmas[1] <- sigma0
  iterYi(mu0, sigma0)
  for (i in 2:length) {
    t <- iterYi(mus[i - 1], sigmas[i - 1])
    mus[i] <- t[1]
    sigmas[i] <- t[2]
  }
  c(mus, sigmas)
}

# Perform samples
length <- 20000
a1 <- 1
b1 <- length
b2 <- 2 * length
a2 <- length + 1
mus <- list(1, 2, 3)
sigmas <- list(1, 2, 3)
for (i in 1:3) {
  samples <- Gibbs(Y[[i]], length)
  mus[[i]] <- samples[a1:b1]
  sigmas[[i]] <- samples[a2:b2]
}

# Permutations we use for (d) and (e)
# I looked it up and there is a package for this but this is only six rows
permutations <- matrix(0, 6, 3)
permutations[1, 1:3] <- c(1, 2, 3)
permutations[2, 1:3] <- c(1, 3, 2)
permutations[3, 1:3] <- c(2, 1, 3)
permutations[4, 1:3] <- c(2, 3, 1)
permutations[5, 1:3] <- c(3, 1, 2)
permutations[6, 1:3] <- c(3, 2, 1)


## (a)
for (i in 1:3) {
  muMean <- mean(mus[[i]])
  sigmaMean <- mean(sigmas[[i]])
  print(paste("The posterior mean for mu of", Ynames[[i]], "is", muMean))
  print(paste("The posterior mean for sigma^2 of", Ynames[[i]], "is", sigmaMean)
  )
}

## (b)
for (i in 1:3) {
  muQuant <- quantile(mus[[i]], probs = c(0.025, 0.975))
  sigmaQuant <- quantile(sigmas[[i]], probs = c(0.025, 0.975))
  print(paste(
    "The empirical 95% confidence interval for mu of", Ynames[[i]],
    "is(", muQuant[1], ",", muQuant[2], ")"
  ))
  print(paste(
    "The empirical 95% confidence interval for sigma^2 of",
    Ynames[[i]], "is (", sigmaQuant[1], ",", sigmaQuant[2], ")"
  ))
}

## (c)
for (i in 1:6) {
  perm <- permutations[i, 1:3]
  t <- 0
  # Check and tally for which samples this holds true
  for (j in 1:length) {
    if (mus[[perm[1]]][j] < mus[[perm[2]]][j]) {
      if (mus[[perm[2]]][j] < mus[[perm[3]]][j]) {
        t <- t + 1
      }
    }
  }
  # Normalize and print
  t <- t / length
  cat(sprintf("P(mu%d < mu%d < mu%d) = %f\n", perm[1], perm[2], perm[3], t))
}

## (d)
# This is an application of the indirect Monte Carlo approximation from lecture
# 5.
for (i in 1:6) {
  perm <- permutations[i, 1:3]
  t <- 0
  for (j in 1:length) {
  # Very similar to (c) though we sample each distribution once
    samples <- 1:3
    for (k in 1:3) {
      mu <- mus[[perm[k]]][j]
      sigma <- sigmas[[perm[k]]][j]
      samples[k] <- rnorm(1, mu, sqrt(sigma))
    }
    if (samples[1] < samples[2]) {
      if (samples[2] < samples[3]) {
        t <- t + 1
      }
    }
  }
  t <- t / length
  cat(sprintf("P(~Y%d < ~Y%d < ~Y%d) = %f\n", perm[1], perm[2], perm[3], t))
}

## (e)
t <- 0
for (i in 1:length) {
  if (mus[[1]][i] > mus[[2]][i]) {
    if (mus[[1]][i] > mus[[3]][i]) { 
      t = t + 1
    }
  }
}
t <- t / length
cat(sprintf("P(mu1 < mu2, mu1  < mu3) = %f\n", t))

## (f)
t <- 0
for (j in 1:length) {
  samples <- 1:3
  for (k in 1:3) {
    mu <- mus[[k]][j]
    sigma <- sigmas[[k]][j]
    samples[k] <- rnorm(1, mu, sqrt(sigma))
  }
  if (samples[1] > samples[2]) {
    if (samples[2] > samples[3]) {
      t <- t + 1
    }
  }
}
t <- t / length
cat(sprintf("P(~Y1<~Y2, ~Y1<~Y3) = %f\n", t))
